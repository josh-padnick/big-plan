{
  "schemaVersion": 2,
  "fixturePaths": [
    "examples/all-components.mdx",
    "examples/mdx-components.mdx",
    "examples/deck.mdx"
  ],
  "stylingFilePatterns": [
    "^\\.style-snapshots/config\\.json$",
    "^bun\\.lock$",
    "^package\\.json$",
    "^assets/(?:logo-(?:light|dark)\\.svg|favicon-(?:light|dark)\\.ico)$",
    "^scripts/gen-assets\\.mjs$",
    "^scripts/gen-css\\.mjs$",
    "^src/.*\\.css$",
    "^src/components/(?:.*/)?view[^/]*\\.tsx$",
    "^src/components/_shared/.*\\.tsx$",
    "^src/icons/lucide/.*\\.ts$",
    "^src/render/branding\\.generated\\.ts$",
    "^src/render/global\\.generated\\.ts$",
    "^src/render/page\\.ts$",
    "^src/render/render-document\\.ts$",
    "^src/render/serialize-html\\.ts$",
    "^src/render/(?:markdown|shell)/.*\\.ts$"
  ],
  "manifestDirectory": ".style-snapshots/manifests",
  "capturePolicy": {
    "globalFilePatterns": [
      "^\\.style-snapshots/",
      "^bun\\.lock$",
      "^package\\.json$",
      "^assets/",
      "^scripts/",
      "^examples/",
      "^src/components/_shared/",
      "^src/components/(?:part|slide)/",
      "^src/icons/",
      "^src/render/"
    ]
  },
  "captureEnvironment": {
    "authorityClass": "ci-runner"
  },
  "captureCommand": [
    "node",
    "{harnessRoot}/scripts/style-snapshots/capture.mjs"
  ],
  "animatedSurfaceExemptions": [
    {
      "name": "database-schema-index-jump-flash",
      "selector": "[data-database-table-schema] .table-schema-index-jump",
      "reason": "Activation scrolls to the index and briefly flashes its definition."
    },
    {
      "name": "database-schema-column-reorder-feedback",
      "selector": "[data-schema-reorderable] .table-schema-head",
      "reason": "Reorderable headers fade their grippers and render transient drag insertion feedback."
    },
    {
      "name": "code-diff-view-control-feedback",
      "selector": "[data-code-diff] [data-diff-toggle-group]:not([hidden])",
      "reason": "The restored segmented control animates hover and focus color feedback."
    },
    {
      "name": "file-tree-diff-view-control-feedback",
      "selector": "[data-file-tree-diff] [data-tree-toggle-group]:not([hidden])",
      "reason": "The restored segmented control animates hover and focus color feedback."
    }
  ],
  "documents": [
