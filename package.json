{
  "name": "big-plan",
  "version": "0.0.1",
  "description": "Good AI output depends on a great plan. Big Plan makes reviewing agent plans a first-class experience.",
  "license": "MIT",
  "author": "Josh Padnick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josh-padnick/big-plan.git"
  },
  "homepage": "https://github.com/josh-padnick/big-plan#readme",
  "bugs": "https://github.com/josh-padnick/big-plan/issues",
  "type": "module",
  "bin": {
    "big-plan": "bin/big-plan.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "bun run gen:fonts && bun run gen:css && bun run gen:assets && bun run gen:guidance",
    "gen:assets": "node scripts/gen-assets.mjs",
    "gen:css": "node scripts/gen-css.mjs",
    "gen:fonts": "node scripts/gen-fonts.mjs",
    "gen:guidance": "node scripts/gen-guidance.mjs",
    "build": "bun run gen && tsc",
    "test": "bun run gen && vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.8",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lowlight": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/cli": "^4.3.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "agent",
    "plan",
    "review",
    "mdx",
    "axi"
  ],
  "packageManager": "bun@1.3.14"
}
