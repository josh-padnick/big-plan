{
  "name": "big-plan",
  "version": "0.0.1",
  "description": "Good AI output depends on a great plan. Big Plan makes reviewing agent plans a first-class experience.",
  "license": "MIT",
  "author": "Josh Padnick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josh-padnick/big-plan.git"
  },
  "homepage": "https://github.com/josh-padnick/big-plan#readme",
  "bugs": "https://github.com/josh-padnick/big-plan/issues",
  "type": "module",
  "bin": {
    "big-plan": "bin/big-plan.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "bun run gen:fonts && bun run gen:review && bun run gen:css && bun run gen:assets && bun run gen:guidance && bun run gen:skill",
    "gen:assets": "node scripts/gen-assets.mjs",
    "gen:css": "node scripts/gen-css.mjs",
    "gen:fonts": "node scripts/gen-fonts.mjs",
    "gen:guidance": "node scripts/gen-guidance.mjs",
    "gen:skill": "node scripts/gen-skill.mjs",
    "gen:review": "node scripts/gen-review-script.mjs",
    "build": "bun run gen && tsc",
    "test": "bun run gen && vitest run && bun run test:style-history",
    "test:style-history": "node --test scripts/style-contract/*.test.mjs scripts/style-snapshots/*.test.mjs scripts/design-system/*.test.mjs",
    "test:e2e": "playwright test",
    "verify:style-history": "node scripts/style-snapshots/verify-history.mjs",
    "lint": "eslint . && node scripts/style-contract/check.mjs && node scripts/design-system/check.mjs && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@playwright/test": "1.61.1",
    "axi-sdk-js": "^0.1.8",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lowlight": "^3.3.0",
    "mermaid": "11.16.0",
    "property-information": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "agent",
    "plan",
    "review",
    "mdx",
    "axi"
  ],
  "packageManager": "bun@1.3.14"
}
