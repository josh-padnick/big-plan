{
  "name": "grandplan",
  "version": "0.0.1",
  "description": "Good AI output depends on a great plan. GrandPlan makes reviewing agent plans a first-class experience.",
  "license": "MIT",
  "author": "Josh Padnick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josh-padnick/grandplan.git"
  },
  "homepage": "https://github.com/josh-padnick/grandplan#readme",
  "bugs": "https://github.com/josh-padnick/grandplan/issues",
  "type": "module",
  "bin": {
    "grandplan": "bin/grandplan.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "bun run gen:css && bun run gen:scroll-spy && bun run gen:theme-toggle && bun run gen:copy-code",
    "gen:css": "node scripts/gen-css.mjs",
    "gen:scroll-spy": "node scripts/gen-scroll-spy.mjs",
    "gen:theme-toggle": "node scripts/gen-theme-toggle.mjs",
    "gen:copy-code": "node scripts/gen-copy-code.mjs",
    "build": "bun run gen && tsc",
    "test": "bun run gen && vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "axi-sdk-js": "^0.1.8",
    "lucide": "^1.24.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/cli": "^4.3.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.15.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "agent",
    "plan",
    "review",
    "mdx",
    "axi"
  ],
  "packageManager": "bun@1.3.14"
}
