{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "7 days",
  "schedule": ["before 5am on monday"],
  "packageRules": [
    {
      "description": "Group routine minor and patch updates into one weekly PR",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "weekly minor and patch updates"
    },
    {
      "description": "Keep major updates in individual PRs",
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "prConcurrentLimit": 3
}
