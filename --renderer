  // src/render/markdown/components/shared/option-select/option-select.browser.ts
  var decisionRoots = document.querySelectorAll(
    "[data-big-decision], [data-small-decision]"
  );
  var INTERACTIVE_ELEMENT_SELECTOR = [
    "a[href]",
    "area[href]",
    "button",
    "input",
    "label",
    "select",
    "summary",
    "textarea",
    "audio[controls]",
    "video[controls]",
    "[contenteditable]",
    "[role]",
    "[tabindex]"
  ].join(", ");
  for (const root of decisionRoots) {
    if (root.dataset.decisionState === "decided") {
      continue;
    }
    const group = ownedDecisionElement({
      root,
      selector: "[data-decision-options]"
    });
    if (group === null) {
      continue;
    }
    const options = ownedDecisionElements({
      root,
      selector: "[data-option]"
    });
    if (options.length < 2) {
      continue;
    }
    const entries = options.flatMap((option) => {
      const control = option.querySelector("[data-option-control]");
      return control === null ? [] : [{ option, control }];
    });
    if (entries.length !== options.length) {
      continue;
    }
    const question = ownedDecisionElement({
      root,
      selector: "[data-decision-question]"
    })?.textContent?.trim();
    group.setAttribute("role", "radiogroup");
    if (question !== void 0 && question !== "") {
      group.setAttribute("aria-label", question);
    }
    const select = (index) => {
      for (const [position, { option, control }] of entries.entries()) {
        const selected = position === index;
        control.setAttribute("aria-checked", selected ? "true" : "false");
        control.tabIndex = selected || index === -1 && position === 0 ? 0 : -1;
        if (selected) {
          option.dataset.optionSelected = "";
