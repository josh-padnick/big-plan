<script>"use strict";
(() => {
  // src/render/markdown/components/shared/decision-dom/decision-dom.browser.ts
  var DECISION_ROOT_SELECTOR = "[data-big-decision], [data-small-decision]";
  var ownedDecisionElements = ({
    root,
    selector
  }) => [...root.querySelectorAll(selector)].filter(
    (element) => element.closest(DECISION_ROOT_SELECTOR) === root
